{
  "name": "ranko-seo",
  "version": "1.0.0",
  "description": "Ranko - ابزار حرفه‌ای سئو و بهینه‌سازی سایت با ۲۵۱ قاعده در ۲۰ دسته",
  "type": "module",
  "bin": {
    "ranko": "./dist/cli.js"
  },
  "main": "./dist-electron/main/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && npm run electron:build",
    "build:web": "vite build -c vite.web.config.ts",
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc -p electron/tsconfig.json --noEmit",
    "electron:dev": "electron-vite dev -c electron/electron-vite.config.ts",
    "electron:build": "electron-vite build -c electron/electron-vite.config.ts",
    "electron:icon": "node scripts/generate-icon.mjs",
    "electron:pack": "electron-builder install-app-deps && npm run electron:build && electron-builder --dir",
    "electron:dist": "electron-builder install-app-deps && npm run electron:build && electron-builder",
    "electron:dist:mac": "electron-builder install-app-deps && npm run electron:build && electron-builder --mac",
    "electron:dist:win": "electron-builder install-app-deps && npm run electron:build && electron-builder --win",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "seo",
    "ranko",
    "audit",
    "cli",
    "web-vitals",
    "core-web-vitals",
    "lighthouse",
    "meta-tags",
    "structured-data",
    "accessibility",
    "technical-seo"
  ],
  "author": "حمیدرضا درهمی",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derhami/ranko.git"
  },
  "bugs": {
    "url": "https://github.com/derhami/ranko/issues"
  },
  "homepage": "https://ranko.nounproject.ir",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "log-update": "^6.1.0",
    "ora": "^8.1.1",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cheerio": "^1.0.0",
    "@types/cli-progress": "^3.11.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^41.10.3",
    "electron-builder": "^26.7.0",
    "electron-vite": "^5.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "shadcn": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.3.5",
    "tsx": "^4.23.11",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zustand": "^5.0.11"
  }
}
